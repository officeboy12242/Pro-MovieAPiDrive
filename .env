# Local crawler environment (gitignored). Loaded by start-crawler.cmd / manual runs.
MKV_MONGODB_URI=mongodb+srv://serverai_db_user:xxjaikishanxx@telegramudemy.4usbm3y.mongodb.net/?appName=telegramUdemy
MKV_SERVE_ONLY=true
MKV_RENDER_URL=https://pro-movieapidrive.onrender.com
MKV_DATA_DIR=data
MKV_ENGINE=camoufox
MKV_HEADLESS=true
MKV_RELEASE_BROWSER=true
# discovery fleet: 10 simultaneous agents, 15s politeness gap
MKV_DISCOVERY=1
MKV_DISCOVERY_AGENTS=3
MKV_DISCOVERY_GAP_S=15
MKV_DISCOVERY_VAULT_PULL=5000
# cap concurrent mkvbase GETs so agents cannot stampede cf_clearance
MKV_HTTP_CONCURRENCY=2
MKV_HTTP_GAP_S=0.4
MKV_PUSHER_RECENT_S=120
MKV_PUSHER_SEARCH_S=3600
MKV_PUSHER_TERMS=godzilla,interstellar,predestination,oppenheimer
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
