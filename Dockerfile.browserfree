# Browser-free API image. Same deps minus the browser stack: no Camoufox fetch
# (the ~150MB Firefox payload), no GTK/X11 runtime libs. Nothing in this image can
# start a browser -- app/client.py refuses every browser path when MKV_BROWSER_FREE
# is set, and there is no browser binary here to refuse with.
FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MKV_BROWSER_FREE=true

WORKDIR /app

COPY requirements-browserfree.txt .
RUN pip install -r requirements-browserfree.txt

COPY app ./app

# Render injects $PORT; default 8765 for local docker runs
EXPOSE 8765
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8765}"]
