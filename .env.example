# ---------------------------------------------------------------------------
# Template for .env  —  copy to .env and fill in.  NEVER commit .env itself:
# it holds Atlas credentials.  .env is gitignored for exactly that reason.
#
# This file lists every variable the crawler reads, including the optional
# overflow shard (a second Atlas cluster).  Values below are placeholders.
# ---------------------------------------------------------------------------

# --- MongoDB ---------------------------------------------------------------
# Primary cluster.  When unset the crawler falls back to a file-backed index
# (data/mongo_uri.txt, or <repo>/data/mongo_uri.txt for the primary).
MKV_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# Database and collection.  Defaults shown.
MKV_MONGO_DB=mkvbase

# --- Overflow shard (optional second cluster) ------------------------------
# When the primary's quota fills, rows with site id >= MKV_MONGO_OVERFLOW_MIN_ID
# are written to a SECOND Atlas cluster; reads merge both.  Rows without a
# numeric id always stay on the primary.  Arm it by supplying a URI, either
# here or as $MKV_DATA_DIR/mongo_uri2.txt.
#
# Pick a threshold on an idgap block boundary (blocks are 25000 wide) so whole
# blocks land on one shard each, and above the current max site id so nothing
# existing moves.
MKV_MONGODB_URI2=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MKV_MONGO_OVERFLOW_MIN_ID=550000

# Force a backend regardless of URI: MKV_INDEX=file uses the local index.
#MKV_INDEX=mongo

# --- Render sync -----------------------------------------------------------
# Search service URL and the shared secret from Render's Environment tab.
# Leave unset when running the API server standalone.
MKV_RENDER_URL=https://<your-service>.onrender.com
MKV_SYNC_KEY=<secret>
MKV_SERVE_ONLY=true
MKV_PUSHER_TERMS=godzilla,interstellar,predestination,oppenheimer
MKV_PUSHER_RECENT_S=120
MKV_PUSHER_SEARCH_S=3600

# --- Discovery fleet -------------------------------------------------------
# Number of simultaneous discovery agents and the politeness gap between
# requests from each one.
MKV_DISCOVERY=1
MKV_DISCOVERY_AGENTS=3
MKV_DISCOVERY_GAP_S=15
# Rows pulled from the site vault to seed the priority lane.
MKV_DISCOVERY_VAULT_PULL=5000

# --- idgap miner -----------------------------------------------------------
MKV_IDGAP_AGENTS=8
MKV_IDGAP_GAP_S=5

# --- HTTP politeness -------------------------------------------------------
# Caps concurrent mkvbase GETs so agents cannot stampede cf_clearance.
MKV_HTTP_CONCURRENCY=2
MKV_HTTP_GAP_S=0.4

# --- engine / paths --------------------------------------------------------
# auto picks whichever browser engine is importable.
MKV_ENGINE=auto
MKV_HEADLESS=true
MKV_RELEASE_BROWSER=true
MKV_DATA_DIR=data

# Set by run-fleet.ps1; leave unset otherwise. Without it Python block-buffers
# stdout and the dashboard's log_age_s reads stale while crawling.
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
PYTHONUTF8=1